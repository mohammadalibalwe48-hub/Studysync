# StudySync Syria — Supabase configuration
# Copy this file to `.env` and fill in real values from your Supabase
# project (Settings -> API). Never commit `.env`.
#
# IMPORTANT: only the anon key is safe to embed in the client app.
# Never put the service role key here.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
