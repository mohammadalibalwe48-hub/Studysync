# StudySync Syria — runtime configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# IMPORTANT: only the anon key is safe to embed in the client app.
# Never put the service role key here.

# ─── Supabase (auth, db, realtime broadcast) ──────────────────────
# Settings -> API in your Supabase project dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── Cloudflare Realtime SFU (study rooms) ────────────────────────
# Optional — leave blank to disable the in-app /study-rooms feature
# (the lobby will show a "feature disabled" card instead of crashing).
# Provision at https://dash.cloudflare.com/?to=/:account/calls
# Free tier: 1,000 GB egress / month, then $0.05/GB.
CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_REALTIME_APP_TOKEN=
